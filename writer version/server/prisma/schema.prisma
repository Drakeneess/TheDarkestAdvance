generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PublishedStory {
  workspaceId String
  storyId     String

  slug        String @unique
  title       String
  description String
  themeKey    String

  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters PublishedChapter[]

  @@id([workspaceId, storyId])
  @@index([workspaceId])

  @@map("published_stories")
}

model PublishedChapter {
  workspaceId String
  storyId     String
  chapterId   String

  sourceVersionId String
  slug            String
  title           String
  order           Int
  content         String

  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story PublishedStory @relation(fields: [workspaceId, storyId], references: [workspaceId, storyId], onDelete: Cascade)

  @@id([workspaceId, storyId, chapterId])
  @@unique([workspaceId, storyId, slug])
  @@index([workspaceId, storyId, order])

  @@map("published_chapters")
}

model SyncWorkspaceAccess {
  workspaceId String
  userId      String
  role        String   @default("owner")
  createdAt   DateTime @default(now())

  @@id([workspaceId, userId])
  @@index([userId, workspaceId])

  @@map("sync_workspace_access")
}

model SyncEntity {
  workspaceId   String
  entityType    String
  entityId      String

  serverVersion BigInt

  payload       Json
  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([workspaceId, entityType, entityId])
  @@index([workspaceId, serverVersion])

  @@map("sync_entities")
}

model SyncChange {
  cursor           BigInt @id @default(autoincrement())

  workspaceId      String
  entityType       String
  entityId         String

  serverVersion    BigInt
  payload          Json

  sourceDeviceId   String
  sourceMutationId String?

  createdAt        DateTime @default(now())

  @@index([workspaceId, cursor])
  @@index([workspaceId, entityType, entityId])

  @@map("sync_changes")
}

model SyncMutation {
  mutationId      String @id

  workspaceId     String
  deviceId        String

  entityType      String
  entityId        String

  clientRevision  Int
  status          String

  serverVersion   BigInt?
  cursor          BigInt?

  result          Json?

  createdAt       DateTime @default(now())

  @@index([workspaceId, deviceId])

  @@map("sync_mutations")
}
