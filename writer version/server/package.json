{
  "name": "writer-sync-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de sincronización para Writer",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --import tsx --test src/auth-login.test.ts",
    "test:access": "prisma generate && node --import tsx --test src/secure-sync.test.ts",
    "test:conflict-policy": "prisma generate && node --import tsx --test src/sync/conflict-rebase.test.ts",
    "test:publishing": "prisma generate && node --import tsx --test src/publishing/*.test.ts",
    "test:assets": "node --import tsx --test src/assets/*.test.ts",
    "test:e2e:codex": "prisma generate && node --import tsx --test --test-concurrency=1 src/e2e/*.e2e.test.ts",
    "auth:hash-password": "tsx src/hash-password.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
