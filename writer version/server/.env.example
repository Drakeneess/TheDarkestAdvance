DATABASE_URL="postgresql://user:password@localhost:5432/writer_sync"

# Mapa JSON userId -> bearer token. Usa tokens aleatorios de 32+ caracteres.
# El mismo userId debe existir en WRITER_AUTH_PASSWORD_HASHES si usará login con contraseña.
WRITER_AUTH_TOKENS='{"local-writer":"replace-with-a-long-random-token-32chars-minimum"}'

# Mapa JSON userId -> hash scrypt-v1 de la contraseña.
# Genera un hash ejecutando desde writer version/server:
#   npm run auth:hash-password
WRITER_AUTH_PASSWORD_HASHES='{"local-writer":"scrypt-v1$replace-salt$replace-digest"}'

# Allowlist exacta separada por comas. No uses * ni barras finales.
# Incluye solo los orígenes desde los que realmente se ejecuta Writer.
WRITER_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost"

# Directorio físico donde se almacenan assets versionados de historias.
# En desarrollo puede omitirse y se usará .data/story-assets relativo al servidor.
# En Railway debe apuntar a un Volume persistente, por ejemplo /data/story-assets.
STORY_ASSET_STORAGE_DIR=".data/story-assets"

# Base pública absoluta usada en las URLs devueltas al Writer.
# Debe terminar conceptualmente en /api/public/assets/stories; no incluyas barra final.
# En local puede omitirse y se deriva de la petición.
# Producción recomendada:
# STORY_ASSET_PUBLIC_BASE_URL="https://thedarkestadvance-production.up.railway.app/api/public/assets/stories"
